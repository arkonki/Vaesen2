# Runtime only. Keep the application and this file outside the public document root.
# URL-encode special characters in database usernames/passwords.
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?schema=public&connection_limit=5"
NEXTAUTH_URL="https://your-app-domain.example"
NEXTAUTH_SECRET="replace-with-output-of-openssl-rand-hex-32"
APP_HOST="127.0.0.1"
PORT="3000"
SEED_ADMIN_EMAIL="admin@your-domain.example"
SEED_ADMIN_NAME="Admin"
# Needed when creating the initial admin. Remove after bootstrap.
SEED_ADMIN_PASSWORD=""
